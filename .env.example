APP_NAME=Kwikpic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FACE_RECOGNITION_API_URL=http://127.0.0.1:8001
FACE_RECOGNITION_MATCH_PATH=/recognize
FACE_RECOGNITION_TIMEOUT=90
FACE_RECOGNITION_PHOTO_LIMIT=60
FACE_RECOGNITION_API_TOKEN=

OTP_DEFAULT_COUNTRY_CODE=+91
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_TEST_MODE=false
OTP_TEST_CODE=123456
OTP_DRIVER=log

# Meta WhatsApp Cloud API (set OTP_DRIVER=whatsapp in production)
META_WHATSAPP_GRAPH_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_OTP_TEMPLATE=
META_WHATSAPP_OTP_LANGUAGE=en_US
META_WHATSAPP_OTP_COPY_CODE_BUTTON=true

# SMTP email
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="Kwikpic"

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_GST_PERCENT=18

GROUP_JOINING_TUTORIAL_URL=
GROUP_JOINING_TUTORIAL_THUMBNAIL=
GROUP_JOINING_TUTORIAL_DURATION=1:30
GROUP_JOINING_TUTORIAL_TITLE="How to join a photo group"
