{
    "name": "lenspic/app",
    "description": "LensPic - AI powered group photo sharing",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "laravel/horizon": "^5.0",
        "predis/predis": "^2.3",
        "inertiajs/inertia-laravel": "^3.3",
        "giggsey/libphonenumber-for-php": "^9.0",
        "twilio/sdk": "^8.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "queue": "php artisan queue:work database --queue=media-high,media-default,exports,maintenance --tries=4 --timeout=600"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
